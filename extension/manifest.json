{
  "manifest_version": 3,
  "name": "Recall AI Tracker",
  "version": "1.0",
  "description": "Tracks browsing activity and sends it to Recall AI backend.",
  "permissions": [
  "tabs",
  "storage",
  "notifications",
  "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
  ,
  "options_page": "options.html"
}
